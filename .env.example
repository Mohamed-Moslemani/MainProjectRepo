#   JWT  
JWT_SECRET=change-me-to-a-secure-random-string

#   HyperPay
HYPERPAY_ACCESS_TOKEN=OGFjN2E0Y...your_test_access_token
HYPERPAY_ENTITY_ID=8ac7a4ca...your_test_entity_id

#   Google Cloud Vision (OCR)  
# Place your service account JSON at credentials/google-vision.json
# Or set the path here:
# OCR_GOOGLE_CREDENTIALS_PATH=/app/credentials/google-vision.json

#   AWS Rekognition (Face Verification)  
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1

#   Database (auto-configured in Docker Compose)  
# GATEWAY_DATABASE_URL=postgresql+asyncpg://docflow:docflow@db:5432/docflow
