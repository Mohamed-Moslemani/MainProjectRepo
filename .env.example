# DocFlow environment template
# Copy to .env.dev (committed-out) for local dev or .env.prod for deployment.
# .env.dev and .env.prod are .gitignore'd — do NOT commit real secrets here.

# ── JWT / Auth ──
# Generate a fresh 32-byte hex value: `openssl rand -hex 32`
GATEWAY_JWT_SECRET=replace-with-`openssl rand -hex 32`-output
GATEWAY_JWT_ALGORITHM=HS256
GATEWAY_JWT_EXPIRY_MINUTES=60
GATEWAY_JWT_REFRESH_EXPIRY_DAYS=2

# ── Internal service URLs ──
# Container hostnames inside docker-compose. Override with public DNS if you
# split services across hosts.
GATEWAY_OCR_SERVICE_URL=http://ocr:8001
GATEWAY_FACE_SERVICE_URL=http://face:8002
GATEWAY_REDIS_URL=redis://redis:6379/0

# ── Stripe ──
# Test keys begin with sk_test_ / whsec_. Use live keys only in real prod.
GATEWAY_STRIPE_SECRET_KEY=sk_test_replace_me
GATEWAY_STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Where Stripe should redirect after checkout — must be the SPA's public URL.
GATEWAY_FRONTEND_BASE_URL=https://your-domain.example

# ── File storage ──
GATEWAY_UPLOAD_DIR=/app/uploads
GATEWAY_MAX_UPLOAD_SIZE_MB=10

# ── Token expiry windows ──
GATEWAY_RESET_TOKEN_EXPIRY_MINUTES=15
GATEWAY_VERIFICATION_TOKEN_EXPIRY_HOURS=24

# ── SMTP ──
# Gmail app password format: 16 chars, dash-separated quartets.
GATEWAY_SMTP_HOST=smtp.gmail.com
GATEWAY_SMTP_PORT=587
GATEWAY_SMTP_USER=you@example.com
GATEWAY_SMTP_PASSWORD=replace_me
GATEWAY_SMTP_FROM_EMAIL=you@example.com
GATEWAY_SMTP_FROM_NAME=DocFlow
GATEWAY_SMTP_USE_TLS=true
GATEWAY_APP_BASE_URL=https://your-domain.example

# ── CORS allow-list ──
# Comma-separated, no trailing slashes. Empty = block every cross-origin
# browser request (gateway logs WARNING on startup if empty).
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.example

# ── Rate limits (per-IP unless suffixed _PER_EMAIL) ──
GATEWAY_RATE_LIMIT_PER_MINUTE=60
GATEWAY_RATE_LIMIT_LOGIN_PER_MINUTE=10
GATEWAY_RATE_LIMIT_LOGIN_PER_EMAIL_PER_MINUTE=5
GATEWAY_RATE_LIMIT_RESET_PER_IP_PER_HOUR=5
GATEWAY_RATE_LIMIT_VERIFICATION_PER_IP_PER_HOUR=5

# ── AI providers ──
# Real-mode: OCR_MOCK_MODE=false + valid AWS / Google credentials below.
# Mock-mode: OCR_MOCK_MODE=true (no external calls, deterministic fixtures).
OCR_MOCK_MODE=true
FACE_MOCK_MODE=true

# AWS Rekognition (face match + liveness)
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
AWS_REGION=us-east-1

# Google Cloud Vision (OCR)
# Mount the service-account JSON at this path — see credentials/ folder.
# OCR_GOOGLE_CREDENTIALS_PATH=/app/credentials/google-vision.json

# OpenAI / LLM extractor (vision-LLM fallback for table-shaped docs)
OCR_LLM_PROVIDER=openai
OCR_LLM_MODEL=gpt-4o
OCR_LLM_FALLBACK_ENABLED=true
OCR_LLM_FALLBACK_MIN_FIELDS=3
OPENAI_API_KEY=replace_me

# ── Object storage (uploaded documents) ──
# Dev points at MinIO container. For prod swap for real S3 (omit endpoint URL,
# set FORCE_PATH_STYLE=false, use IAM-managed creds).
STORAGE_S3_ENDPOINT_URL=http://minio:9000
STORAGE_S3_BUCKET=docflow-uploads
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY=replace_me
STORAGE_S3_SECRET_KEY=replace_me
STORAGE_S3_FORCE_PATH_STYLE=true

# ── Observability ──
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
TRACING_ENABLED=true
LOG_FORMAT=json
# Sentry / GlitchTip DSNs. Leave blank to disable error reporting.
SENTRY_DSN=
VITE_SENTRY_DSN=

# ── Frontend build ──
# Browser hits this URL for API calls. Compose default = http://localhost:8000.
# For prod, set to https://your-domain.example (Caddy proxies to gateway).
VITE_API_URL=http://localhost:8000
