# DocFlow — cloud override env file.
#
# Copy to `.env.cloud` and fill in the placeholders. Then run:
#
#   docker compose --env-file .env.cloud \
#     -f docker-compose.yml -f docker-compose.cloud.yml up -d
#
# This file ONLY contains values that differ in cloud mode. Everything
# else (JWT secret, Stripe keys, OCR/Face mocks, OpenAI key, SMTP) is
# inherited from .env.dev via env_file in docker-compose.yml. Keep
# secrets here out of git — see .gitignore.

# ───────── Grafana Cloud (metrics + traces + logs) ─────────────────
# Stack home: https://grafana.com/orgs/<org>/stacks/<stack-id>
# Free tier: 10k series, 50 GB logs, 50 GB traces, 14-day retention.

# Mimir / Prometheus remote_write endpoint. Format:
#   https://prometheus-prod-XX-prod-XX-region.grafana.net/api/prom/push
GRAFANA_CLOUD_PROM_URL=
# Numeric stack ID — found on the same "Send Metrics" panel.
GRAFANA_CLOUD_PROM_USER=
# Cloud Access Policy token with `metrics:write` scope.
GRAFANA_CLOUD_PROM_API_KEY=

# Loki — ship every container's stdout/stderr through Alloy to
# Grafana Cloud Loki. Find the URL on your stack page → "Send Logs"
# tile (format: https://logs-prod-XX.grafana.net/loki/api/v1/push).
# User is the same numeric stack ID used for Prom/Alertmanager.
# Token needs `logs:write` scope (regenerate from Access Policies if
# the existing one only has metrics:write).
GRAFANA_CLOUD_LOKI_URL=
GRAFANA_CLOUD_LOKI_USER=
GRAFANA_CLOUD_LOKI_API_KEY=

# Mimir Alertmanager URL — needed only by
# scripts/import_grafana_cloud_alertmanager.py. Find it on your stack
# details page → "Alertmanager" tile.
# Format: https://alertmanager-prod-<region>.grafana.net
GRAFANA_CLOUD_ALERTMANAGER_URL=
# Token with `alerts:write` scope (generate on the Alertmanager Details
# page; the metrics-only token won't work here).
GRAFANA_CLOUD_ALERTS_API_KEY=

# Optional contact-point secrets, inlined into the cloud-managed
# Alertmanager YAML at upload time. Leave blank to skip wiring that
# receiver — alerts will still fire but won't notify until you set
# the URL/key and re-run the import script.
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=

# Tempo OTLP gRPC endpoint for traces. Format:
#   tempo-prod-XX-prod-XX-region.grafana.net:443
# Apps already emit OTLP — we just retarget the endpoint and add auth.
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTLP Authorization header. Format (note URL-encoded comma %2C):
#   Authorization=Basic%20<base64(stack_id:api_token)>
# Generate with:
#   echo -n "<stack_id>:<otlp_token>" | base64
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# ───────── Sentry (error tracking) ─────────────────────────────────
# Replaces GlitchTip. Free tier: 5k errors/mo, 30-day retention.
# Create a project at https://sentry.io → Settings → Projects → DSN.

# Backend DSN — same one used for gateway, ocr, face, registry, web (server).
SENTRY_DSN=
# Frontend DSN — separate "browser" project so PII filtering rules differ.
VITE_SENTRY_DSN=

# ───────── Langfuse Cloud (AI observability) ───────────────────────
# Already cloud-pointing in .env.dev (LANGFUSE_BASE_URL=https://cloud.langfuse.com).
# Override here only if you swap to a different Langfuse project for
# the cloud deployment — otherwise leave blank and the .env.dev keys
# carry through.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ───────── Cloudflare R2 (S3-compatible object storage) ────────────
# Free tier: 10 GB storage, 1M Class A ops/mo, 10M Class B ops/mo,
# zero egress. Create at: Cloudflare dashboard → R2 → Create bucket.
# API tokens at: R2 → Manage R2 API Tokens → Create with read+write.
#
# Endpoint format: https://<account-id>.r2.cloudflarestorage.com
STORAGE_S3_ENDPOINT_URL=
STORAGE_S3_BUCKET=docflow-uploads
STORAGE_S3_REGION=auto
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
# R2 requires virtual-hosted-style requests — keep this false.
STORAGE_S3_FORCE_PATH_STYLE=false

# ───────── Neon Postgres (optional) ────────────────────────────────
# Recommended ONLY if you uncomment the `db: profiles: ["off"]` block
# in docker-compose.cloud.yml. For local dev parity we keep Postgres
# in a container. Free tier: 0.5 GB storage, 190 compute-hours/mo.
#
# Format:
#   postgresql+asyncpg://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require
# GATEWAY_DATABASE_URL=

# ───────── Frontend build args (cloud deploy) ──────────────────────
# Public URL the SPA hits. For local-cloud-mode this stays
# http://localhost:8000; for a real cloud deploy point at your gateway's
# public hostname.
# VITE_API_URL=http://localhost:8000
