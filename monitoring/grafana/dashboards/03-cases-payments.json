{
  "id": null,
  "uid": "docflow-cases-payments",
  "title": "DocFlow — Cases & Payments",
  "tags": ["docflow", "cases", "payments"],
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1, "title": "Case Pipeline", "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false
    },
    {
      "id": 2, "title": "Cases Created", "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "targets": [{ "expr": "sum(docflow_cases_created_total) or vector(0)", "legendFormat": "Total", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" } } },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 3, "title": "Cases Submitted", "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "targets": [{ "expr": "sum(docflow_cases_submitted_total) or vector(0)", "legendFormat": "Submitted", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "green" } } },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 4, "title": "Auto-Approved", "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 1 },
      "targets": [{ "expr": "docflow_pipeline_decisions_total{decision=\"auto_approve\"} or vector(0)", "legendFormat": "Approved", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "green" } } },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 5, "title": "Manual Review", "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 1 },
      "targets": [{ "expr": "docflow_pipeline_decisions_total{decision=\"manual_review\"} or vector(0)", "legendFormat": "Review", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "orange" } } },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 6, "title": "Auto-Rejected", "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 },
      "targets": [{ "expr": "docflow_pipeline_decisions_total{decision=\"reject\"} or vector(0)", "legendFormat": "Rejected", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "red" } } },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 7, "title": "Cases by Service Type", "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 6 },
      "targets": [
        { "expr": "sum by (service_type) (docflow_cases_created_total)", "legendFormat": "{{service_type}}", "refId": "A" }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "right" } }
    },
    {
      "id": 8, "title": "Cases Created Over Time", "type": "timeseries",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 6 },
      "targets": [
        { "expr": "increase(docflow_cases_created_total[5m])", "legendFormat": "{{service_type}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } } }
    },
    {
      "id": 9, "title": "Status Transitions", "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "targets": [
        { "expr": "increase(docflow_case_status_transitions_total[5m])", "legendFormat": "{{from_status}} → {{to_status}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } } }
    },
    {
      "id": 20, "title": "Documents", "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 }, "collapsed": false
    },
    {
      "id": 21, "title": "Documents Uploaded (total)", "type": "stat",
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 23 },
      "targets": [
        { "expr": "sum by (document_type) (docflow_documents_uploaded_total)", "legendFormat": "{{document_type}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 30, "title": "Payments", "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 28 }, "collapsed": false
    },
    {
      "id": 31, "title": "Checkouts Created", "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 29 },
      "targets": [{ "expr": "docflow_payments_created_total or vector(0)", "legendFormat": "Created", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" } } },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 32, "title": "Payments Completed", "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 29 },
      "targets": [{ "expr": "docflow_payments_completed_total or vector(0)", "legendFormat": "Completed", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "green" } } },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 33, "title": "Payments Failed", "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 29 },
      "targets": [{ "expr": "docflow_payments_failed_total or vector(0)", "legendFormat": "Failed", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "red" } } },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 34, "title": "Payment Success Rate", "type": "gauge",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 29 },
      "targets": [{ "expr": "(docflow_payments_completed_total / (docflow_payments_completed_total + docflow_payments_failed_total)) * 100 or vector(0)", "legendFormat": "%", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "red" }, { "value": 80, "color": "yellow" }, { "value": 95, "color": "green" }] }
        }
      }
    },
    {
      "id": 40, "title": "External Service Calls", "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 }, "collapsed": false
    },
    {
      "id": 41, "title": "External Call Duration (avg)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 35 },
      "targets": [
        { "expr": "rate(docflow_external_call_duration_seconds_sum[5m]) / rate(docflow_external_call_duration_seconds_count[5m])", "legendFormat": "{{service}} avg", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 10 } } }
    },
    {
      "id": 42, "title": "External Call Errors", "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 35 },
      "targets": [
        { "expr": "sum by (service) (docflow_external_call_errors_total) or vector(0)", "legendFormat": "{{service}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "red" } } },
      "options": { "colorMode": "value", "graphMode": "area" }
    }
  ]
}