{
  "id": null,
  "uid": "docflow-postgresql",
  "title": "DocFlow — PostgreSQL",
  "tags": ["docflow", "postgresql", "infrastructure"],
  "timezone": "browser",
  "refresh": "15s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1, "title": "PostgreSQL Status", "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "pg_up", "legendFormat": "Status", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "red" }, { "value": 1, "color": "green" }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none" }
    },
    {
      "id": 2, "title": "Active Connections", "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "sum(pg_stat_activity_count)", "legendFormat": "Active", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" } } },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 3, "title": "Max Connections", "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "pg_settings_max_connections", "legendFormat": "Max", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "purple" } } },
      "options": { "colorMode": "value", "graphMode": "none" }
    },
    {
      "id": 4, "title": "Connection Usage %", "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "(sum(pg_stat_activity_count) / pg_settings_max_connections) * 100", "legendFormat": "%", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "green" }, { "value": 60, "color": "yellow" }, { "value": 80, "color": "red" }] }
        }
      }
    },
    {
      "id": 5, "title": "Connections Over Time", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "sum by (state) (pg_stat_activity_count)", "legendFormat": "{{state}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } } }
    },
    {
      "id": 6, "title": "Connections by Database", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "sum by (datname) (pg_stat_activity_count{datname!=''})", "legendFormat": "{{datname}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 15 } } }
    },
    {
      "id": 10, "title": "Database Size", "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 12 },
      "targets": [{ "expr": "pg_database_size_bytes{datname=\"docflow\"}", "legendFormat": "docflow", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "fixed", "fixedColor": "blue" } } },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 11, "title": "Transactions / sec", "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
      "targets": [
        { "expr": "rate(pg_stat_database_xact_commit{datname=\"docflow\"}[1m])", "legendFormat": "Commits", "refId": "A" },
        { "expr": "rate(pg_stat_database_xact_rollback{datname=\"docflow\"}[1m])", "legendFormat": "Rollbacks", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 15 } } }
    },
    {
      "id": 12, "title": "Rows Returned vs Fetched / sec", "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
      "targets": [
        { "expr": "rate(pg_stat_database_tup_returned{datname=\"docflow\"}[1m])", "legendFormat": "Returned", "refId": "A" },
        { "expr": "rate(pg_stat_database_tup_fetched{datname=\"docflow\"}[1m])", "legendFormat": "Fetched", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 10 } } }
    },
    {
      "id": 13, "title": "Row Mutations / sec", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        { "expr": "rate(pg_stat_database_tup_inserted{datname=\"docflow\"}[1m])", "legendFormat": "Inserts", "refId": "A" },
        { "expr": "rate(pg_stat_database_tup_updated{datname=\"docflow\"}[1m])", "legendFormat": "Updates", "refId": "B" },
        { "expr": "rate(pg_stat_database_tup_deleted{datname=\"docflow\"}[1m])", "legendFormat": "Deletes", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 15 } } }
    },
    {
      "id": 14, "title": "Cache Hit Ratio", "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 20 },
      "targets": [
        { "expr": "pg_stat_database_blks_hit{datname=\"docflow\"} / (pg_stat_database_blks_hit{datname=\"docflow\"} + pg_stat_database_blks_read{datname=\"docflow\"}) * 100", "legendFormat": "Hit Ratio", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "red" }, { "value": 90, "color": "yellow" }, { "value": 99, "color": "green" }] }
        }
      }
    },
    {
      "id": 15, "title": "Database Size Over Time", "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 20 },
      "targets": [
        { "expr": "pg_database_size_bytes{datname=\"docflow\"}", "legendFormat": "docflow", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 15 } } }
    }
  ]
}