{
  "id": null,
  "uid": "docflow-gateway-api",
  "title": "DocFlow — Gateway API & Auth",
  "tags": ["docflow", "gateway", "auth"],
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1, "title": "Authentication", "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false
    },
    {
      "id": 2, "title": "Registrations", "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "targets": [{ "expr": "docflow_auth_registrations_total or vector(0)", "legendFormat": "Total", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "green" } } },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 3, "title": "Successful Logins", "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
      "targets": [{ "expr": "docflow_auth_logins_total{status=\"success\"} or vector(0)", "legendFormat": "Logins", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" } } },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 4, "title": "Failed Logins", "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 },
      "targets": [{ "expr": "docflow_auth_logins_total{status=\"failed\"} or vector(0)", "legendFormat": "Failed", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "red" } } },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 5, "title": "Rate Limited", "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 1 },
      "targets": [{ "expr": "docflow_auth_logins_total{status=\"rate_limited\"} or vector(0)", "legendFormat": "Rate Limited", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "orange" } } },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 6, "title": "Password Resets", "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 1 },
      "targets": [{ "expr": "docflow_auth_password_resets_total or vector(0)", "legendFormat": "Resets", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "purple" } } },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 7, "title": "Email Verifications", "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 },
      "targets": [{ "expr": "docflow_auth_email_verifications_total{status=\"success\"} or vector(0)", "legendFormat": "Verified", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "green" } } },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 10, "title": "API Endpoints", "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 }, "collapsed": false
    },
    {
      "id": 11, "title": "Requests by Endpoint (last hour)", "type": "bargauge",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 7 },
      "targets": [
        { "expr": "sum by (handler) (increase(http_requests_total{job=\"gateway\"}[1h]))", "legendFormat": "{{handler}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 50, "color": "yellow"}, {"value": 200, "color": "red"}] } } },
      "options": { "orientation": "horizontal", "displayMode": "gradient" }
    },
    {
      "id": 12, "title": "Endpoint Latency (avg)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "targets": [
        { "expr": "rate(http_request_duration_seconds_sum{job=\"gateway\"}[5m]) / rate(http_request_duration_seconds_count{job=\"gateway\"}[5m])", "legendFormat": "{{handler}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 10 } } }
    },
    {
      "id": 13, "title": "Errors by Endpoint (last hour)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "targets": [
        { "expr": "sum by (handler, status) (increase(http_requests_total{job=\"gateway\", status=~\"4..|5..\"}[1h]))", "legendFormat": "{{handler}} ({{status}})", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } } }
    },
    {
      "id": 14, "title": "Emails", "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 }, "collapsed": false
    },
    {
      "id": 15, "title": "Emails Sent (total)", "type": "stat",
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 26 },
      "targets": [
        { "expr": "sum by (type) (docflow_emails_sent_total) or vector(0)", "legendFormat": "{{type}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "green" } } },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 16, "title": "Email Failures (total)", "type": "stat",
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 26 },
      "targets": [
        { "expr": "sum by (type) (docflow_emails_failed_total) or vector(0)", "legendFormat": "{{type}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "red" } } },
      "options": { "colorMode": "value", "graphMode": "area" }
    }
  ]
}