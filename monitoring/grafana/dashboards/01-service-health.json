{
  "id": null,
  "uid": "docflow-health",
  "title": "DocFlow — Service Health",
  "tags": ["docflow", "health"],
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Service Status",
      "type": "stat",
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 0 },
      "targets": [
        { "expr": "up", "legendFormat": "{{job}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "red" }, { "value": 1, "color": "green" }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" }
    },
    {
      "id": 2,
      "title": "Request Rate (all services)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [
        { "expr": "sum by (job) (increase(http_requests_total[1m]))", "legendFormat": "{{job}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 15 } } }
    },
    {
      "id": 3,
      "title": "Error Rate (4xx + 5xx)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [
        { "expr": "sum by (job, status) (increase(http_requests_total{status=~\"4..|5..\"}[1m]))", "legendFormat": "{{job}} {{status}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 20 } } }
    },
    {
      "id": 4,
      "title": "Avg Latency (all services)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "targets": [
        { "expr": "rate(http_request_duration_highr_seconds_sum[5m]) / rate(http_request_duration_highr_seconds_count[5m])", "legendFormat": "{{job}} avg", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 10 } } }
    },
    {
      "id": 5,
      "title": "P95 Latency (all services)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, job) (rate(http_request_duration_highr_seconds_bucket[5m])))", "legendFormat": "{{job}} p95", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 10 } } }
    },
    {
      "id": 6,
      "title": "Total Requests (last hour)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 21 },
      "targets": [
        { "expr": "sum by (job) (increase(http_requests_total[1h]))", "legendFormat": "{{job}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 7,
      "title": "Successful vs Failed (last hour)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 21 },
      "targets": [
        { "expr": "sum(increase(http_requests_total{status=~\"2..\"}[1h]))", "legendFormat": "2xx Success", "refId": "A" },
        { "expr": "sum(increase(http_requests_total{status=~\"4..|5..\"}[1h]))", "legendFormat": "4xx/5xx Errors", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 8,
      "title": "Requests by Status Code",
      "type": "piechart",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 21 },
      "targets": [
        { "expr": "sum by (status) (increase(http_requests_total[1h]))", "legendFormat": "{{status}}", "refId": "A" }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "right" } }
    }
  ]
}