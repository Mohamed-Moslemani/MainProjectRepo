// Grafana Alloy config — scrapes the same /metrics endpoints
// Prometheus used to scrape, then remote_writes to Grafana Cloud
// Mimir. Replaces the local prometheus container in cloud mode.
//
// Auth uses the Prometheus username (numeric stack ID) + a Grafana
// Cloud API token with `metrics:write` scope as the password. Find
// both at https://grafana.com/orgs/<your-org>/stacks/<id> →
// "Send Metrics" panel.

prometheus.scrape "app_services" {
  targets = [
    { __address__ = "gateway:8000",  job = "gateway",  service = "gateway"  },
    { __address__ = "ocr:8001",      job = "ocr",      service = "ocr"      },
    { __address__ = "face:8002",     job = "face",     service = "face"     },
    { __address__ = "registry:8003", job = "registry", service = "registry" },
  ]
  metrics_path    = "/metrics"
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

// Sidecars that translate native protocol stats to Prometheus
// metrics. The Redis + PostgreSQL dashboards (05-redis, 04-postgresql)
// read directly from these — without scraping them every panel reads
// "No data". Both exporters listen on their library defaults
// (9121 for redis-exporter, 9187 for postgres-exporter) inside the
// docflow_default network and aren't exposed on the host.
prometheus.scrape "exporters" {
  targets = [
    { __address__ = "redis-exporter:9121",    job = "redis",    service = "redis"    },
    { __address__ = "postgres-exporter:9187", job = "postgres", service = "postgres" },
  ]
  metrics_path    = "/metrics"
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_PROM_URL")
    basic_auth {
      username = sys.env("GRAFANA_CLOUD_PROM_USER")
      password = sys.env("GRAFANA_CLOUD_PROM_API_KEY")
    }
  }
}


// ── Logs: ship every Docker container's stdout/stderr to Loki ──
// Replaces having to `docker logs <container>` on the droplet.
// Discovery: query the Docker socket every 5s for running
// containers; relabel so each line carries `service` (the part
// of the container name after "docflow-", before the "-1"
// instance suffix) plus the original container name. Output:
// browse logs in Grafana Cloud Explore → Loki → {service="gateway"}
// or {service=~"gateway.*"} to combine workers/cron with the API.

discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  // Drop the alloy container itself — shipping our own logs back to
  // ourselves creates feedback loops on errors.
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?docflow-alloy-1"
    action        = "drop"
  }

  // Container name → service label. "/docflow-gateway-1" → "gateway".
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?docflow-([^-]+(?:_[^-]+)?)-\\d+"
    target_label  = "service"
    replacement   = "$1"
  }

  // Keep the full container name available for filtering.
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?(.+)"
    target_label  = "container"
    replacement   = "$1"
  }

  // Static label so logs from this stack don't mingle with anything
  // else later sharing the Loki tenant.
  rule {
    target_label = "stack"
    replacement  = "docflow"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  labels     = {}
  forward_to = [loki.write.grafana_cloud.receiver]
}

loki.write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_LOKI_URL")
    basic_auth {
      username = sys.env("GRAFANA_CLOUD_LOKI_USER")
      password = sys.env("GRAFANA_CLOUD_LOKI_API_KEY")
    }
  }
}
